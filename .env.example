# Root-level env for docker-compose + deploy tooling.
# Copy to .env and fill in — .env is gitignored, never commit real values.

# Funded Coston2 private key for contract deploys / proxy signing.
DEPLOYMENT_PRIVATE_KEY=
INITIAL_OWNER=
PROXY_PRIVATE_KEY=

CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114

# TEE governance (defaults to INITIAL_OWNER as sole signer, threshold 1)
GOVERNANCE_SIGNERS=
GOVERNANCE_THRESHOLD=1

# Must be false once running against real Coston2 attestation
LOCAL_MODE=false
SIMULATED_TEE=true

# Public URL for the ext-proxy (ngrok/cloudflared tunnel) — data providers
# must be able to reach this.
EXT_PROXY_URL=https://<your-tunnel>.ngrok-free.dev
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
