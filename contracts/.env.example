# contracts/.env — forge loads this automatically when run from this directory
# (`cd contracts && forge script ...`). Copy to contracts/.env and fill in; never commit
# the real file (already covered by the repo's top-level `.env*` gitignore rule).

# Funded Coston2 key used to broadcast SubmitWeatherSettlement / ExecuteWeatherSettlement.
# Can reuse the same value as the root .env's DEPLOYMENT_PRIVATE_KEY.
PRIVATE_KEY=

# Flare FDC Verifier API (prepareRequest step). Get a testnet key at
# https://fdc-verifiers-testnet.flare.network — same key that would go in flare-foundry-starter's
# VERIFIER_API_KEY_TESTNET.
VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network
VERIFIER_API_KEY_TESTNET=

# Flare Data Availability Layer (proof retrieval step).
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network
X_API_KEY=

# OpenWeatherMap current-weather API — https://openweathermap.org/api
OPEN_WEATHER_API_KEY=
