# Copy to .env.local — never commit real values.

# Overrides the Coston2 deployment address baked into src/lib/contract.ts.
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=0x9C22c9F1954f2E1D7B305c0E2932edEBE713bDc3

# TEE's ECIES public key (X, Y — 32 bytes each), used to client-side encrypt
# bets before placeBet(). Not derivable from teeAddress() (a one-way hash of
# the pubkey). The simulated extension (extension/src/server.ts) prints these
# to its own console on boot as "public key X:" / "public key Y:".
NEXT_PUBLIC_TEE_PUBKEY_X=
NEXT_PUBLIC_TEE_PUBKEY_Y=

# Server-only: base URL of the TEE proxy's *external* port, used by
# app/api/tee/result/route.ts to fetch signed settlement/withdrawal results
# without hitting browser CORS. See root .env.example's NORMAL_PROXY_URL.
TEE_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Server-only: base URL of the simulated TEE's own balance API
# (extension/src/server.ts's Express server, Step 2) — a DIFFERENT service
# from TEE_PROXY_URL above (that one is the official tee-proxy, which has no
# /balance route). Used by app/api/tee/balance/route.ts. Defaults to the
# local extension server; production should point at wherever that server's
# port 3002 is tunneled to (e.g. a Cloudflare Tunnel route on
# flare-tee.idolpulse.com), once that routing exists.
TEE_BALANCE_URL=http://localhost:3002
